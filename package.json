{
  "name": "comparelab",
  "displayName": "CompareLab",
  "icon": "media/comparelab-icon.png",
  "description": "Compare AI models and prompt variants in VS Code with inline diffs, controlled evaluations, and local-first Ollama/OpenAI-compatible runners.",
  "version": "0.2.0",
  "publisher": "azayzel-comparelab",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Azayzel/CompareLab.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "main": "./src/extension.js",
  "type": "commonjs",
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:comparelab.open",
    "onView:comparelab.launcher"
  ],
  "contributes": {
    "commands": [
      {
        "command": "comparelab.open",
        "title": "CompareLab: Compare Model Outputs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "comparelab",
          "title": "CompareLab",
          "icon": "media/comparelab.svg"
        }
      ]
    },
    "views": {
      "comparelab": [
        {
          "id": "comparelab.launcher",
          "name": "CompareLab"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "comparelab.launcher",
        "contents": "Compare models or test a prompt change.\n[Open CompareLab](command:comparelab.open)\nReports open side by side in the editor."
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.js && npm test",
    "vscode:prepublish": "npm run build",
    "compare": "node bin/comparelab.js",
    "package": "vsce package --no-dependencies --out dist/comparelab.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}